# Copiar a .env (`cp .env.example .env`) y cambiar las contraseñas. .env no se commitea.
# Lo leen el justfile, el docker compose y la API. Las contraseñas: sin @ : / ? # (van dentro de una URL).

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# Contraseña de Drizzle Gateway.
MASTERPASS=change-me

# Para correr la API en local contra `just up`. En el clúster estas URLs las arma `just k8s-secrets`.
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
REDIS_URL=redis://localhost:6379

# Opcional. Por defecto 0.0.0.0:3000.
BIND_ADDR=0.0.0.0:3000
RUST_LOG=debug
